[Unit]
Description=Upload Aviator Brew website changes to GitHub
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/skynet/mdd/aviatorbrew/source
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="GIT_SSH_COMMAND=ssh -F /dev/null -i /home/skynet/.ssh/aviatorbrew_github -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/home/skynet/.ssh/known_hosts"
ExecStart=/home/skynet/mdd/aviatorbrew/source/scripts/daily-upload-if-changed.sh
TimeoutStartSec=30min
UMask=0077
