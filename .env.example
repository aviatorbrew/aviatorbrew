# Server-side SMTP mail delivery. Keep secrets only in .env.local or deployment secrets.
# MAIL_MODE=smtp sends real email. MAIL_MODE=record only logs delivery attempts.
MAIL_MODE=smtp
SMTP_HOST=mail.aviatorbrew.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=aviator@aviatorbrew.com
MAIL_FROM_NAME=Aviator Brewing Company
MAIL_REPLY_TO=aviator@aviatorbrew.com
FORM_RECIPIENT_EMAIL=aviator@aviatorbrew.com
SMTP_VERIFY_ON_START=true

# Optional: POST general form submissions to a CRM, email, or automation endpoint.
FORM_WEBHOOK_URL=

# Public canonical URL for production metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://aviatorbrew.com

# Required for the password-protected location menu uploader.
MENU_LIBRARY_KEY=choose-a-long-random-access-key

# Brewery tour registration and email delivery.
# Configure ONE delivery option. The webhook receives { to, subject, text, category }.
TOUR_EMAIL_WEBHOOK_URL=
# Or use a verified Resend sender:
RESEND_API_KEY=
TOUR_FROM_EMAIL=Aviator Tours <tours@aviatorbrew.com>

# Required to protect the weekly tour notification endpoint.
TOUR_CRON_KEY=choose-a-long-random-cron-secret

# Stripe-hosted Checkout. Keep all live and test credentials out of version control.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
# Create this in Stripe when the public webhook endpoint is registered.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Recipient for paid private-event room booking notifications.
PRIVATE_EVENT_PAYMENT_RECIPIENT_EMAIL=events@aviatorbrew.com
# Optional fallback hosted checkout URL for the $20 tour ticket.
TOUR_PAYMENT_URL=

# Optional override for persistent tour signup storage.
# TOUR_DATA_FILE=/var/data/aviatorbrew/state/tour-signups.json

# Coupon system: one-time QR validation and special-event blackouts.
COUPON_VALIDATION_KEY=choose-a-long-staff-validation-key
# Optional override for persistent coupon data.
# COUPON_DATA_FILE=/var/data/aviatorbrew/state/coupons.json
# Optional comma-separated YYYY-MM-DD special event blackout dates.
COUPON_SPECIAL_EVENT_DATES=

# Required for the separate manager portal at /manager.
MANAGER_PORTAL_KEY=choose-a-long-manager-password
MANAGER_PORTAL_EMAIL=manager@example.com

# Gift-card provider endpoint. Receives { cardNumber } and returns { balance, currency }.
GIFT_CARD_BALANCE_API_URL=

# Aviator Live band application URL. Override locally only when Aviator Live is running on this machine.
AVIATOR_LIVE_APPLY_URL=https://aviatorlive.beer/apply

# Aviator Live public schedule source. This server-side URL provides the confirmed show feed.
AVIATOR_LIVE_SCHEDULE_URL=https://aviatorlive.beer/api/public/live-music

# Optional override for manager-published keg inventory. Upload the BrewOps JSON in Manager Portal > Kegs.
# KEG_INVENTORY_DATA_FILE=/var/data/aviatorbrew/state/keg-inventory.json

# Optional override for newsletter subscribers captured from the website and keg orders.
# NEWSLETTER_DATA_FILE=/var/data/aviatorbrew/state/newsletter-subscribers.json
# NEWSLETTER_CAMPAIGNS_DATA_FILE=/var/data/aviatorbrew/state/newsletter-campaigns.json
# MANAGER_AUTH_DATA_FILE=/var/data/aviatorbrew/state/manager-auth.json

# Optional overrides for manager-created events and beer records.
# MANAGED_EVENTS_DATA_FILE=/var/data/aviatorbrew/state/managed-events.json
# MANAGED_BEERS_DATA_FILE=/var/data/aviatorbrew/state/managed-beers.json
# BEER_OVERRIDES_DATA_FILE=/var/data/aviatorbrew/state/beer-overrides.json
# MANAGED_BEVERAGES_DATA_FILE=/var/data/aviatorbrew/state/managed-beverages.json
# BEVERAGE_OVERRIDES_DATA_FILE=/var/data/aviatorbrew/state/beverage-overrides.json
# PRIVATE_EVENT_PAYMENTS_DATA_FILE=/var/data/aviatorbrew/state/private-event-payments.json
# BRANDING_MEDIA_DIRECTORY=/var/data/aviatorbrew/branding
# BEER_IMAGES_DIRECTORY=/var/data/aviatorbrew/beer-images
# BEVERAGE_IMAGES_DIRECTORY=/var/data/aviatorbrew/beer-images
# WEBSITE_PHOTOS_DIRECTORY=/var/data/aviatorbrew/website-photos
# MANAGED_EVENT_IMAGES_DIRECTORY=/var/data/aviatorbrew/event-images
# FLIGHT_LOG_IMAGE_DIRECTORY=/var/data/aviatorbrew/flight-log-images
# FLIGHT_LOG_AVATAR_DIRECTORY=/var/data/aviatorbrew/flight-log-avatars
# FLIGHT_LOG_POST_MEDIA_DIRECTORY=/var/data/aviatorbrew/flight-log-posts

# Beer release homepage alert
BEER_RELEASE_ALERT_DATA_FILE=/var/data/aviatorbrew/state/beer-release-alert.json
BEER_RELEASE_ALERT_ASSET_DIRECTORY=/var/data/aviatorbrew/beer-release-alert-assets

# ShopNew cart and USPS shipping
EASYPOST_API_KEY=
EASYPOST_USPS_CARRIER_ACCOUNT_ID=
SHOP_CHECKOUT_SIGNING_SECRET=
SHOPIFY_PRODUCTS_URL=https://aviatorbrew.myshopify.com/products.json?limit=250
SHOP_PRODUCT_IMAGES_DIRECTORY=/var/data/aviatorbrew/shop-products
